// FinOps Audit Query: Find SQL Virtual Machines on Unconstrained High-Core SKUs
// Run in Azure Resource Graph Explorer
Resources
| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.sqlvirtualmachine/sqlvirtualmachines'
| extend vmSize = tostring(properties.hardwareProfile.vmSize)
| where vmSize matches regex '(?i)Standard_E(16|32|64)s_v[0-9]+'
| where not(vmSize matches regex '(?i)Standard_E[0-9]+-[0-9]+s_v[0-9]+') // Exclude already constrained
| project 
    subscriptionId, 
    resourceGroup, 
    name, 
    vmSize, 
    PotentialTargetSKU = replace_regex(vmSize, 'Standard_E([0-9]+)s_v([0-9]+)', 'Standard_E\\1-8s_v\\2'),
    PotentialSavings = "Up to 75% reduction on SQL Server core licenses with Constrained vCPU (CCC)",
    FinOpsAction = "Evaluate telemetry: If peak CPU < 25%, resize to Constrained Core variant"
| order by name asc
